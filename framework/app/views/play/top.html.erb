<div class="header">
    <div>
      <span class="mini-title-ai">
        <%= image_tag "heart2.PNG", class: "mini-heart-bg" %>
        AI
      </span>
      <span class="mini-title-suru">する</span>
      <div class="mini-title-wrap">
        <span class="mini-bg-text">スゴロク</span>
        <span class="mini-fg-text">スゴロク</span>
      </div>
    </div>
    <h3 class="show-map-title"><%= @sugoroku["title"] %></h3>
    <div>
        <% if current_user %>
            <span><%= current_user.uname %> さん</span>

            <%= button_to "ログアウト",
                "/logout",
                method: :delete,
                class: "login-button" %>
        <% else %>
            <button
                class="login-button"
                onclick="location.href='/login'"
            >
                ログイン
            </button>
        <% end %>
    </div>
</div>

<!-- プレイヤー登録モーダル -->
<div id="player-modal" class="modal">
  <div class="modal-content">
    <h2>プレイヤー登録</h2>
    
    <%= form_with url: '/play/input-member', method: :post, local: true do |f| %>   

      <div style="display: flex; align-items: center; justify-content: space-between;">   
        <h3 style="display: inline">・プレイヤー人数</h3>
        <%= f.select :player_count, options_for_select([[1, 1], [2, 2], [3, 3], [4, 4]], selected: 2), {include_blank: "人数を選んでね"}, { class: "player-count" } %>
      </div>
        
      <h3>・プレイヤーの名前</h3>
      <div id="player-names" class="player-names-container">
        <%= :player_count.each_with_index do |count, index| %>
          <%= f.text_field "player_names[]", placeholder: "name#{index + 1}", class: "player-names" %>
        <% end %>
      </div>

      <%= f.submit "決定", class: "action-button", onclick: "closeModal()" %>
      <script>
          function closeModal() {

          document
          .getElementById("player-modal")
          .style.display = "none";
          }
      </script>
    <% end %>
  </div>
</div>

<!-- すごろくmapの表示 -->
<div class="content-center">
    
    <div id="board">
      <!-- 線用レイヤー -->
      <svg id="lines"></svg>

      <!-- マス用レイヤー -->
      <div id="map"></div>
    </div>

    <script>
      // RailsのデータをJSに渡す（重要）
      const sugoroku = <%= @sugoroku.to_json.html_safe %>;
    </script>

    <!-- 外部JS読み込み -->
    <%= javascript_include_tag "sugoroku_map" %>
</div>
</div>


