<div class="header">
    <h1 class="site-title">AI生成スゴロク</h1>
    <div class="content-right">
        <% if current_user %>
            <span><%= current_user.uname %> さん</span>
            <%= button_to "ログアウト",
                "/logout",
                method: :delete,
                class: "login-button" %>
        <% else %>
            <button
                class="login-button"
                onclick="location.href='/login'"
            >
                ログイン
            </button>
        <% end %>
    </div>
</div>

<div id="player-modal" class="modal">

  <div class="modal-content">
    <h2>プレイヤー登録</h2>
    <div class="content-sidebyside">

    <h3>プレイヤー人数</h3>
    <input
        type="number"
        min="1"
        max="4"
        value="2"
        class="player-count"
    >

</div>
    <button onclick="closeModal()">
      決定
    </button>
    <script>
        function closeModal() {

        document
        .getElementById("player-modal")
        .style.display = "none";
        }
    </script>
</div>

</div>

<% if @map.present? %>
  <div class="sugoroku-display">
    <h2><%= @map.map_name %></h2>

    <% @squares.each do |square| %>
      <p>
        <%= square.position %>マス目:
        <%= square.square_text %>
        （<%= square.effect %>, <%= square.value %>）
      </p>
    <% end %>
  </div>
<% else %>
  <div class="sugoroku-display">
    <p>生成されたスゴロクがありません。</p>
  </div>
<% end %>