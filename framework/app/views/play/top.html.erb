<div class="header">
    <div>
      <span class="mini-title-ai">
        <%= image_tag "heart2.PNG", class: "mini-heart-bg" %>
        AI
      </span>
      <span class="mini-title-suru">する</span>
      <div class="mini-title-wrap">
        <span class="mini-bg-text">スゴロク</span>
        <span class="mini-fg-text">スゴロク</span>
      </div>
    </div>
    <h3 class="show-map-title"><%= @sugoroku["title"] %></h3>
    <div>
        <% if current_user %>
            <span><%= current_user.uname %> さん</span>

            <%= button_to "ログアウト",
                "/logout",
                method: :delete,
                class: "login-button" %>
        <% else %>
            <button
                class="login-button"
                onclick="location.href='/login'"
            >
                ログイン
            </button>
        <% end %>
    </div>
</div>

<!-- プレイヤー登録モーダル -->
<div id="overlay" class="overlay">
  <div id="player-modal" class="modal">
    <div class="modal-content">
      <h2>プレイヤー登録</h2>
      
      <%= form_with url: '/play/input-member', method: :post, data: { turbo: false }, local: true do |f| %>   

        <div style="display: flex; align-items: center; justify-content: space-between;">   
          <h3 style="display: inline">・プレイヤー人数</h3>
          <%= f.select :player_count, options_for_select([[1, 1], [2, 2], [3, 3], [4, 4]], selected: 2), 
              {include_blank: "人数を選んでね"}, 
              { class: "player-count", onchange: "updatePlayerFields(this.value)"} %>
        </div>
          
        <h3>・プレイヤー情報</h3>
        <div id="player-info-container" class="player-info-container">
        </div>
        <script>
          function updatePlayerFields(count) {
            const container = document.getElementById('player-info-container');
            container.innerHTML = ''; // 一度中身をリセット

            // 選択された人数（count）の分だけループして入力欄を作成
            for (let i = 0; i < count; i++) {
              const player = document.createElement( 'div' );              
              const name = document.createElement('input');
              const color = document.createElement('input');

              player.className = 'player-info';
              name.type = 'text';
              name.name = 'player_names[]'; // Railsが配列として受け取れる名前
              name.placeholder = `プレイヤー ${i + 1}`;
              name.className = 'player-names';
              color.type = 'color';
              color.className = 'player-color';
              color.name = 'player_colors[]';

              player.appendChild(name);
              player.appendChild(color);
              
              container.appendChild(player);
            }
          }

          // 画面が表示された最初（初期値: 2人）にも動くように実行しておく
          document.addEventListener('DOMContentLoaded', () => {
            updatePlayerFields(2); 
          });
        </script>
        <div style="text-align: center; margin-top: 40px">
          <%= f.submit "START", class: "action-button", onclick: "closeModal()" %>
        </div>
        <script>
            function closeModal() {

            document.getElementById("overlay").style.display = "none";

            }
        </script>
      <% end %>
    </div>
  </div>
</div>

<!-- ゲーム画面の表示 -->
<div class="game-container">

  <!-- すごろくmapの表示 -->
  <div class="sugoroku-display">   
    <div id="map-camera" class="map-camera">
      <div id="board">
        <!-- 線用レイヤー -->
        <svg id="lines"></svg>

        <!-- マス用レイヤー -->
        <div id="map"></div>
      </div>

      <script>
        // RailsのデータをJSに渡す（重要）
        const sugoroku = <%= @sugoroku.to_json.html_safe %>;
      </script>

      <!-- 外部JS読み込み -->
      <%= javascript_include_tag "sugoroku_map" %>
    </div>
  </div>
</div>





