<h2>ログイン (テスト用)</h2>

<% if @error_message.present? %>
  <p style="color:red;">
    <%= @error_message %>
  </p>
<% end %>

<%= form_with url: "/login", method: :post, data: { turbo: false } do %>

  <p>ユーザー名</p>
  <input type="text" name="uname">

  <p>パスワード</p>
  <input type="password" name="password">

  <br>
  <button type="submit">ログイン</button>

  <br><br>
    <button
        type="button"
        onclick="location.href='/signup'"
    >
        新規登録
</button>
<br><br>
<button
    type="button"
    onclick="location.href='/home'"
>
    ホームへ戻る
<% end %>