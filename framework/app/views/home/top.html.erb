<div class="content-right">
    <% if current_user %>
        <span>
            <%= current_user.uname %> さん
        </span>
        <%= button_to "ログアウト",
            "/logout",
            method: :delete,
            class: "login-button" %>
    <% else %>
        <button
            class="login-button"
            onclick="location.href='/login'"
        >
            ログイン
        </button>
    <% end %>
</div>
<h1 class="home-header">AI 生成スゴロク</h1>
<%= form_with url: "/home/generate", method: :post, data: { turbo: false } do %>
    <div class="content-center">
        <textarea 
            name="prompt"
            placeholder="どんなスゴロクを作りたいか（例：テーマや設定）を入力してください"
            class="prompt-input"
        ></textarea>
    </div>
    <div class="content-center">
        <button 
        type="submit"
        class="generate-button"
        >生成</button>
    </div>
<% end %>
