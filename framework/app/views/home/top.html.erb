<div class="header">
    <div>
        <span class="mini-title-ai">
            <%= image_tag "heart2.PNG", class: "mini-heart-bg" %>
            AI
        </span>
        <span class="mini-title-suru">する</span>
        <div class="mini-title-wrap">
            <span class="mini-bg-text">すごろく</span>
            <span class="mini-fg-text">すごろく</span>
        </div>
    </div>
    <div>
        <% if current_user %>
            <span class="add-usually-font" style="font-size: 14px;"><%= current_user.uname %> さん</span>

            <%= button_to "ログアウト",
                "/logout",
                method: :delete,
                class: "login-button" %>
        <% else %>
            <button
                class="login-button"
                onclick="location.href='/login'"
            >
                ログイン
            </button>
        <% end %>
    </div>
</div>

<h1 class="home-header">
    <div class="border-decor">
        <span class="title-ai">
        <%= image_tag "heart2.PNG", class: "heart-bg" %>
        AI
        </span>
        <span class="title-suru">する</span>
        <div class="title-wrap">
            <span class="bg-text">すごろく</span>
            <span class="fg-text">すごろく</span>
        </div>
    </div>
</h1>

<%= form_with url: "/home/generate", method: :post, data: { turbo: false } do %>
    <div class="content-center margin-top-60">
        <textarea 
            name="prompt"
            placeholder="どんなスゴロクを作りたいか（例：テーマや設定）を入力してください"
            class="prompt-input"
        ></textarea>
    </div>
    <div class="content-center margin-top-60">
        <button 
        type="submit"
        data-loading="ai"
        class="generate-button"
        >生成</button>
    </div>
<% end %>

<!-- ローディングUI（レイアウトに1回だけ置く） -->
<div id="loading-overlay" class="loading-overlay hidden">
    <div class="loading-box">
        生成中…
    </div>
</div>